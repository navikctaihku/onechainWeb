# Copy to repo root as .stp.env (gitignored) and fill in your values.
# cp stp/.stp.env.example .stp.env

STP_HOST=43.159.33.46
STP_SSH_PORT=9522
STP_SSH_USER=ubuntu

# Your DNS record: onechainWebsiteMockup → 43.159.33.46
# Full URL is usually lowercase: onechainwebsitemockup.<your-parent-domain>
# Example if parent is ai-rwa.xyz:
STP_DOMAIN=onechainwebsitemockup.ai-rwa.xyz

STP_WEB_ROOT=/var/www/onechain
